# DOMAIN comes from .env. Unset -> plain http on port 80 (use the droplet IP).
# Set to e.g. gridlock.example.com -> Caddy fetches an HTTPS certificate automatically.
{$DOMAIN::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

GEMINI_API_KEY=
# Local dev: docker-compose sets DATABASE_URL for you.
# Deploy: point this at Tiger Data.
DATABASE_URL=

# Optional: override the Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=

# Production: your domain once DNS points at the server (leave unset to use the IP)
# DOMAIN=gridlock.example.com
